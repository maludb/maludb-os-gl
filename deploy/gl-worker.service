[Unit]
Description=General Ledger worker: the outbox (email, texts through the kernel), the kernel's AI statement poll, recurring templates falling due, reminders, the secure links' expiry, dispatch (one pass)
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory={{APP_DIR}}
ExecStart=/usr/bin/php {{APP_DIR}}/bin/worker.php
