{
    "schema": "maludb-os.application/1",
    "catalog_key": "gl",
    "name": "General Ledger",
    "description": "The books: a chart of accounts, a double-entry journal with fiscal periods, the financial statements (P&L, balance sheet, trial balance, cash flow), accounts receivable (customers, invoices, receipts, deposits), accounts payable (vendors, bills, payment runs) and cash management that ties every bank account out to the bank's statement — with no bank feed and no way to move money. The kernel's monthly AI statement becomes one bill per provider.",
    "business_area": "Finance",
    "category": "accounting",
    "icon": "feather-book-open",
    "version": "0.1.0",
    "criticality": "high",
    "grant_standing_departments": false,
    "vhost": {
        "label": "gl",
        "document_root": "html",
        "internal_port_env": "APP_INTERNAL_PORT"
    },
    "database": {
        "suffix": "gl",
        "migrations": "db",
        "roles": {
            "rw": "gl_rw",
            "records_ro": "gl_records_ro",
            "activity_ro": "gl_activity_ro"
        }
    },
    "env": {
        "required": [
            "APP_NAME",
            "APP_URL",
            "DB_HOST",
            "DB_PORT",
            "DB_NAME",
            "DB_USER",
            "DB_PASSWORD",
            "MCP_RECORDS_DB_USER",
            "MCP_RECORDS_DB_PASSWORD",
            "MCP_ACTIVITY_DB_USER",
            "MCP_ACTIVITY_DB_PASSWORD",
            "APP_INTERNAL_PORT",
            "MCP_RECORDS_PORT",
            "MCP_ACTIVITY_PORT",
            "ACTION_TOKEN_KEY",
            "ACTIONS_RELAY_KEY",
            "OS_APPLICATION_TOKEN",
            "OS_INTERNAL_URL",
            "OS_LAUNCHER_URL",
            "APP_KEY",
            "MALUDB_API_URL",
            "MALUDB_API_TOKEN"
        ],
        "optional": [
            "MALUMAIL_API_KEY",
            "MALUMAIL_API_URL",
            "MAIL_FROM",
            "MAIL_FROM_NAME",
            "ATTACHMENT_MAX_BYTES",
            "GL_LINK_LIFETIME_DAYS",
            "API_CORS_ORIGINS"
        ]
    },
    "services": [
        "deploy/gl-records-mcp.service",
        "deploy/gl-activity-mcp.service",
        "deploy/gl-activity-ingest.service",
        "deploy/gl-activity-ingest.timer",
        "deploy/gl-directory-sync.service",
        "deploy/gl-directory-sync.timer",
        "deploy/gl-worker.service",
        "deploy/gl-worker.timer"
    ],
    "endpoints": [
        {
            "name": "Records MCP",
            "kind": "mcp",
            "path": "/mcp/records",
            "port_env": "MCP_RECORDS_PORT",
            "auth_kind": "bearer",
            "agent_reachable": true,
            "mcp_surface_version": "1.0"
        },
        {
            "name": "Activity MCP",
            "kind": "mcp",
            "path": "/mcp/activity",
            "port_env": "MCP_ACTIVITY_PORT",
            "auth_kind": "bearer",
            "agent_reachable": true,
            "mcp_surface_version": "1.0"
        },
        {
            "name": "Web UI",
            "kind": "ui",
            "path": "/",
            "auth_kind": "none",
            "agent_reachable": false
        },
        {
            "name": "Health",
            "kind": "http_api",
            "path": "/api/v1/health",
            "auth_kind": "none",
            "agent_reachable": false
        }
    ],
    "actions": {
        "manifest": "docs/gl-action-manifest.md",
        "registry": "mcp/action_registry.json",
        "base_url_env": "APP_INTERNAL_PORT"
    },
    "skills": [
        "skills/gl-basics",
        "skills/the-chart-and-posting-rules",
        "skills/writing-to-customers",
        "skills/import-the-ai-statement",
        "skills/match-the-bank",
        "skills/month-end-close",
        "skills/collections-review"
    ],
    "sso": {
        "path": "/sso",
        "logout_path": "/sso/logout"
    },
    "directory": {
        "reads": true,
        "writes": false
    },
    "assistant": {
        "command_bar": true,
        "agent": "expert"
    },
    "shares": [
        {
            "tool": "account_balances",
            "description": "Ledger balances by account as of a date (for another application's dashboard)",
            "scoped": false
        },
        {
            "tool": "ap_due_summary",
            "description": "Amounts due to vendors per week, no vendor named",
            "scoped": false
        },
        {
            "tool": "ar_aging_summary",
            "description": "Receivables by aging bucket, no customer named",
            "scoped": false
        }
    ],
    "agents": [
        {
            "key": "expert",
